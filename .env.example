# Next.js Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:3000

# AWS Configuration (Required for AWS CloudWatch Exporter & AWS Monitoring)
# Note: When deploying on AWS EC2, you can attach an IAM Role with `CloudWatchReadOnlyAccess` 
# to the EC2 instance instead of storing long-term credentials here.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# Monitoring Credentials & Storage
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION=200h

# ============================================================================
# SERVICE URLs (Default: localhost or replace with your AWS EC2 Public IP / Domain)
# Example: http://<YOUR_EC2_PUBLIC_IP>:3001 or https://grafana.yourdomain.com
# ============================================================================
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
NEXT_PUBLIC_LOKI_URL=http://localhost:3100
NEXT_PUBLIC_TEMPO_URL=http://localhost:3200
NEXT_PUBLIC_ALERTMANAGER_URL=http://localhost:9093
